diff --git a/js/splash.js b/js/splash.js
new file mode 100644
index 0000000..d550d2a
--- /dev/null
+++ b/js/splash.js
@@ -0,0 +1,31 @@
+// Splash screen: gambar diambil dari endpoint server (/.netlify/functions/splash),
+// yang membaca sumber splash HoYoLab. Kalau gagal, pakai icon app sebagai fallback.
+const SPLASH_DURATION_MS = 3000;
+const SPLASH_FALLBACK = 'icons/icon-512.png';
+
+const Splash = {
+  async fetchImageUrl() {
+    try {
+      const resp = await fetch('/.netlify/functions/splash', { cache: 'no-store' });
+      const json = await resp.json();
+      return json.url || SPLASH_FALLBACK;
+    } catch {
+      return SPLASH_FALLBACK;
+    }
+  },
+
+  run(durationMs) {
+    const el = document.getElementById('splash');
+    const img = document.getElementById('splash-img');
+    if (!el || !img) return Promise.resolve();
+    const minWait = new Promise((r) => setTimeout(r, durationMs));
+    const imgReady = this.fetchImageUrl().then((url) => {
+      img.onerror = () => { img.onerror = null; img.src = SPLASH_FALLBACK; };
+      img.src = url;
+    });
+    return Promise.all([minWait, imgReady]).then(() => {
+      el.classList.add('fade-out');
+      return new Promise((r) => setTimeout(() => { el.classList.add('hidden'); r(); }, 400));
+    });
+  },
+};
diff --git a/netlify/functions/splash.js b/netlify/functions/splash.js
new file mode 100644
index 0000000..13d97db
--- /dev/null
+++ b/netlify/functions/splash.js
@@ -0,0 +1,12 @@
+// Mengembalikan URL gambar splash. Sumber diatur lewat env var SPLASH_URL di Netlify
+// (isi dengan URL gambar splash HoYoLab yang kamu temukan).
+// Kalau env var kosong, client otomatis pakai fallback icon app.
+exports.handler = async () => {
+  const headers = {
+    'Content-Type': 'application/json',
+    'Access-Control-Allow-Origin': '*',
+    'Cache-Control': 'public, max-age=300',
+  };
+  const url = (process.env.SPLASH_URL || '').trim();
+  return { statusCode: 200, headers, body: JSON.stringify({ url: url || null }) };
+};
