From 9bac9516cc499d94744770bdf2fa3db1f166d656 Mon Sep 17 00:00:00 2001
From: Dit <dit@local>
Date: Wed, 23 Sep 2026 04:11:14 +0000
Subject: [PATCH] fix: avatar karakter gak muncul + nama main/sub stat artefak
 kosong

- fallback beberapa nama field gambar (icon/image/side_icon/card_image) + placeholder saat gambar gagal load
- resolve nama stat via property_map (lookup by property_type) yang sebelumnya gak dipakai, jadi selalu fallback ke teks generik
---
 js/app.js | 34 +++++++++++++++++++++++++---------
 1 file changed, 25 insertions(+), 9 deletions(-)

diff --git a/js/app.js b/js/app.js
index fd16393..6fa78c9 100644
--- a/js/app.js
+++ b/js/app.js
@@ -243,10 +243,16 @@ async function loadCharacters(force = false) {
   }
 }
 
+// API HoyoLab kadang balikin field gambar beda-beda tergantung endpoint (icon / image / side_icon / card_image).
+// Coba semua kemungkinan biar avatar gak blank.
+function charIcon(c) {
+  return c.icon || c.image || c.side_icon || c.card_image || '';
+}
+
 function renderCharacterGrid(el, chars) {
   el.innerHTML = `<div class="char-grid">${chars.map((c) => `
     <div class="char-card" data-id="${c.id}">
-      <img src="${c.icon}" loading="lazy" alt="${c.name}">
+      <img src="${charIcon(c)}" loading="lazy" alt="${c.name}" onerror="this.onerror=null;this.classList.add('img-fallback');this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22%3E%3Crect width=%22100%22 height=%22100%22 fill=%22%232a2a3a%22/%3E%3C/svg%3E';">
       <div class="name">${c.name}</div>
       <div class="lv">Lv.${c.level}</div>
       <div class="const">C${c.actived_constellation_num ?? 0}</div>
@@ -266,7 +272,7 @@ async function openCharacterDetail(id) {
   try {
     const data = await Api.getCharacterDetail([id]);
     const c = (data.list || data.avatars || [])[0];
-    renderCharacterDetail(content, c);
+    renderCharacterDetail(content, c, data.property_map || {});
   } catch (e) {
     content.innerHTML = `<p class="error">Gagal memuat detail: ${e.message}</p>`;
   }
@@ -280,7 +286,17 @@ function statVal(s) {
   return v !== undefined && v !== null && v !== '' ? v : '-';
 }
 
-function renderCharacterDetail(el, c) {
+// Nama stat (HP%, CRIT DMG, dll) TIDAK selalu ikut nempel di tiap objek stat.
+// Raw API cuma ngirim "property_type" (angka ID) dan naruh nama aslinya di object
+// terpisah "property_map" (dikirim bareng characterDetail). Makanya sebelumnya selalu
+// jatuh ke fallback teks generik "Main Stat"/"Sub Stat". Sekarang di-lookup ke situ dulu.
+function statName(s, propertyMap, fallback) {
+  if (!s) return fallback;
+  const fromMap = propertyMap?.[s.property_type]?.name;
+  return fromMap ?? s.info?.name ?? s.name ?? fallback;
+}
+
+function renderCharacterDetail(el, c, propertyMap) {
   if (!c) { el.innerHTML = '<p class="error">Data tidak ditemukan.</p>'; return; }
   const base = c.base || c;
   const weapon = c.weapon || {};
@@ -288,7 +304,7 @@ function renderCharacterDetail(el, c) {
   const stats = c.selected_properties || c.base_properties || [];
   el.innerHTML = `
     <div class="detail-header">
-      <img src="${base.icon}" alt="${base.name}">
+      <img src="${charIcon(base)}" alt="${base.name}" onerror="this.onerror=null;this.style.visibility='hidden';">
       <div>
         <div class="name">${base.name}</div>
         <div class="muted">Lv.${base.level} · C${base.actived_constellation_num ?? 0}</div>
@@ -297,7 +313,7 @@ function renderCharacterDetail(el, c) {
 
     <div class="section-label">Senjata</div>
     <div class="equip-item">
-      <img src="${weapon.icon ?? ''}" alt="">
+      <img src="${weapon.icon ?? ''}" alt="" onerror="this.onerror=null;this.style.visibility='hidden';">
       <div>
         <div class="name">${weapon.name ?? '-'}</div>
         <div class="sub">Lv.${weapon.level ?? '-'} · R${weapon.affix_level ?? '-'} · ★${weapon.rarity ?? '-'}</div>
@@ -308,7 +324,7 @@ function renderCharacterDetail(el, c) {
     ${relics.length ? relics.map((r, i) => `
       <div class="equip-item-wrap">
         <div class="equip-item equip-clickable" data-relic-idx="${i}">
-          <img src="${r.icon ?? ''}" alt="">
+          <img src="${r.icon ?? ''}" alt="" onerror="this.onerror=null;this.style.visibility='hidden';">
           <div style="flex:1">
             <div class="name">${r.name ?? r.pos_name ?? '-'}</div>
             <div class="sub">+${r.level ?? 0} · ★${r.rarity ?? '-'} · ${r.set?.name ?? ''}</div>
@@ -316,15 +332,15 @@ function renderCharacterDetail(el, c) {
           <span class="chevron">▾</span>
         </div>
         <div class="relic-stats hidden" id="relic-stats-${i}">
-          ${r.main_property ? `<div class="stat-row main-stat"><span>${r.main_property.info?.name ?? r.main_property.name ?? 'Main Stat'}</span><span>${statVal(r.main_property)}</span></div>` : ''}
-          ${(r.sub_property_list || []).map((s) => `<div class="stat-row sub-stat"><span>${s.info?.name ?? s.name ?? 'Sub Stat'}</span><span>${statVal(s)}</span></div>`).join('')}
+          ${r.main_property ? `<div class="stat-row main-stat"><span>${statName(r.main_property, propertyMap, 'Main Stat')}</span><span>${statVal(r.main_property)}</span></div>` : ''}
+          ${(r.sub_property_list || []).map((s) => `<div class="stat-row sub-stat"><span>${statName(s, propertyMap, 'Sub Stat')}</span><span>${statVal(s)}</span></div>`).join('')}
         </div>
       </div>
     `).join('') : '<p class="muted">Tidak ada data artefak.</p>'}
 
     <div class="section-label">Stat</div>
     <div class="stat-list">
-      ${stats.length ? stats.map((s) => `<div class="stat-row"><span>${s.info?.name ?? s.name ?? 'Stat'}</span><span>${statVal(s)}</span></div>`).join('')
+      ${stats.length ? stats.map((s) => `<div class="stat-row"><span>${statName(s, propertyMap, 'Stat')}</span><span>${statVal(s)}</span></div>`).join('')
         : '<p class="muted">Stat detail tidak tersedia dari API.</p>'}
     </div>
   `;
-- 
2.43.0

